{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",

  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },

  "files": {
    "includes": [
      "**",
      "!dist",
      "!node_modules",
      "!coverage",
      "!tests/visual/.output",
      "!docs/REFERENCE.md",
      "!docs/PLAN.md",
      "!*.build.html",
      "!**/*.build.html",
      "!**/*.svelte",
      "!website/.next",
      "!website/.source",
      "!website/out",
      "!website/package-lock.json",
      "!website/next-env.d.ts",

      // Design canvases. A `.dc.html` is a generated artboard — inline styles,
      // template placeholders, decorative SVG with no title — so every a11y and
      // style rule fires on markup nobody hand-edits and nothing ships. They
      // are read as a visual reference when authoring a theme, not built.
      "!*.dc.html",
      "!**/*.dc.html",

      // Test data. Whitespace is significant — the content of doc-code,
      // doc-diff and doc-tree is rendered verbatim, and the validator tests
      // assert exact line numbers — so reformatting these silently changes what
      // they test.
      "!tests/fixtures",

      // Component stories: author markup like the fixtures, kept out for the
      // same reason. Biome's HTML a11y rules also read contract attributes
      // (`focus` on doc-scene, `drop` on doc-change) as event handlers.
      "!preview/stories"
    ]
  },

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf",
    "includes": ["**", "!**/*.svelte"]
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },

  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",

      "a11y": {
        "useValidAriaRole": "off"
      },

      "style": {
        // §12: no default exports. Overridden below for the config files whose
        // tools require one.
        "noDefaultExport": "error",
        "useConst": "error",
        "useImportType": "error"
      },

      "suspicious": {
        "noDoubleEquals": "error",
        "noConsole": { "level": "error", "options": { "allow": ["warn", "error"] } },
        "noExplicitAny": "error"
      },

      "correctness": {
        // Biome exempts identifiers prefixed with `_`, which is what the
        // previous argsIgnorePattern/varsIgnorePattern did.
        "noUnusedVariables": "error"
      },

      "complexity": {
        // The override story is `@layer`-based (§4.4): everything the library
        // ships is layered, so unlayered author CSS already wins without
        // `!important`. The seven remaining uses are the two places where the
        // library itself must win — `prefers-reduced-motion` in base.css and
        // the print overrides in print.css — and both are standard practice.
        "noImportantStyles": "off"
      }
    }
  },

  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },

  "overrides": [
    {
      "includes": ["website/app/**", "website/*.config.mjs", "website/source.config.ts"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    },
    {
      "includes": ["website/**/*.css"],
      "css": { "parser": { "tailwindDirectives": true } }
    },
    {
      "includes": [
        "*.config.ts",
        "*.config.js",
        "tests/**/*.test.ts",
        "tests/visual/**/*.visual.ts",
        "tools/**/*.mjs",
        "tools/**/*.ts",
        "src/env.d.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}
